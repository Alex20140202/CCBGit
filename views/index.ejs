<%- include('partials/header', { title, site, filters }) %>

<section class="page-head">
  <h1 class="page-title">Repositories</h1>
  <p class="page-sub">
    <%= listing.total %> repositor<%= listing.total === 1 ? 'y' : 'ies' %> indexed on this machine.
    <button class="link-button" data-refresh-repos type="button">Rescan</button>
  </p>
</section>

<form class="filter-bar" method="get" action="/">
  <div class="filter-search">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M15.8 15.8 21 21"></path></svg>
    <input type="search" name="q" value="<%- h.escapeHtml(filters.q) %>" placeholder="Filter by name, description or file…" aria-label="Filter repositories">
  </div>

  <% if (languages.length) { %>
    <label class="select-wrap">
      <span class="sr-only">Language</span>
      <select name="language" data-auto-submit>
        <option value="">All languages</option>
        <% languages.forEach((language) => { %>
          <option value="<%= language %>" <%= filters.language === language ? 'selected' : '' %>><%= language %></option>
        <% }) %>
      </select>
    </label>
  <% } %>

  <label class="select-wrap">
    <span class="sr-only">Sort by</span>
    <select name="sort" data-auto-submit>
      <option value="updated" <%= filters.sort === 'updated' ? 'selected' : '' %>>Last updated</option>
      <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name</option>
      <option value="commits" <%= filters.sort === 'commits' ? 'selected' : '' %>>Commit count</option>
      <option value="size" <%= filters.sort === 'size' ? 'selected' : '' %>>Size</option>
      <option value="created" <%= filters.sort === 'created' ? 'selected' : '' %>>Created</option>
    </select>
  </label>

  <input type="hidden" name="order" value="<%= filters.order %>">
  <button class="primary-button" type="submit">Apply</button>
  <% if (filters.q || filters.language) { %>
    <a class="ghost-button" href="/">Reset</a>
  <% } %>
</form>

<% if (!items.length) { %>
  <div class="empty-state">
    <h2>Nothing found</h2>
    <p>No repository matches <strong><%- h.escapeHtml(filters.q || filters.language) %></strong>.</p>
    <a class="primary-button" href="/">Show all repositories</a>
  </div>
<% } else { %>
  <ul class="repo-grid" id="repo-grid">
    <% items.forEach((item) => { %>
      <li class="repo-card">
        <div class="repo-card-head">
          <h2 class="repo-name">
            <a href="/<%= item.id %>"><%= item.owner %><span class="sep">/</span><strong><%= item.name %></strong></a>
          </h2>
          <span class="badge <%= item.meta && item.meta.bare ? 'badge-bare' : 'badge-live' %>">
            <%= item.meta && item.meta.bare ? 'bare' : 'worktree' %>
          </span>
        </div>

        <p class="repo-desc">
          <%= (item.meta && item.meta.description) ? h.escapeHtml(item.meta.description) : 'No description provided.' %>
        </p>

        <% if (item.languages && item.languages.length) { %>
          <div class="lang-bar" role="img" aria-label="Language breakdown">
            <% item.languages.slice(0, 8).forEach((lang) => { %>
              <span style="width:<%= lang.percent %>%;background:<%= lang.color %>" title="<%= lang.language %> <%= lang.percent %>%"></span>
            <% }) %>
          </div>
          <p class="repo-langs">
            <% item.languages.slice(0, 3).map((l) => l.language).join(' · ') %>
            <% if (item.languages.length > 3) { %> +<%= item.languages.length - 3 %><% } %>
          </p>
        <% } %>

        <div class="repo-card-foot">
          <% if (item.meta && item.meta.latestCommit) { %>
            <a class="repo-last" href="/<%= item.id %>/commit/<%= item.meta.latestCommit.shortSha %>" title="<%- h.escapeHtml(item.meta.latestCommit.subject) %>">
              <span class="sha"><%= item.meta.latestCommit.shortSha %></span>
              <span class="subject"><%- h.escapeHtml(item.meta.latestCommit.subject) %></span>
            </a>
            <span class="repo-when" title="<%= item.meta.latestCommit.author.date %>">
              <%= h.relativeTime(item.meta.latestCommit.author.date) %>
            </span>
          <% } else { %>
            <span class="repo-last muted">No commits yet</span>
          <% } %>
        </div>

        <div class="repo-badges">
          <span class="pill"><%= item.meta ? item.meta.commitCount : 0 %> commits</span>
          <span class="pill"><%= item.meta ? item.meta.branchCount : 0 %> branches</span>
          <span class="pill"><%= item.meta ? h.formatBytes(item.meta.size) : '0 B' %></span>
        </div>
      </li>
    <% }) %>
  </ul>

  <% if (listing.totalPages > 1) { %>
    <nav class="pagination" aria-label="Pagination">
      <% const qs = (p) => {
        const params = new URLSearchParams();
        if (filters.q) params.set('q', filters.q);
        if (filters.language) params.set('language', filters.language);
        params.set('sort', filters.sort);
        params.set('order', filters.order);
        params.set('page', String(p));
        return `/?${params.toString()}`;
      } %>
      <% if (listing.page > 1) { %>
        <a class="page-link" href="<%= qs(listing.page - 1) %>">Previous</a>
      <% } %>
      <span class="page-info">Page <%= listing.page %> of <%= listing.totalPages %></span>
      <% if (listing.page < listing.totalPages) { %>
        <a class="page-link" href="<%= qs(listing.page + 1) %>">Next</a>
      <% } %>
    </nav>
  <% } %>
<% } %>

<%- include('partials/footer') %>
