<%
  const treeUrl = (relPath) => `/${repo.id}/tree/${refEncoded}/${relPath}`;
  const blobUrl = (relPath) => `/${repo.id}/blob/${refEncoded}/${relPath}`;
%>
<form class="clone-form" data-clone-form>
  <input type="hidden" name="ref" value="<%= ref %>">
  <div class="clone-tabs" role="tablist">
    <button type="button" class="clone-tab is-active" data-protocol="https" role="tab">HTTPS</button>
    <button type="button" class="clone-tab" data-protocol="ssh" role="tab">SSH</button>
  </div>
  <div class="clone-row">
    <input class="clone-input" id="clone-url" readonly spellcheck="false"
           value="<%= meta.cloneUrls.https %>"
           aria-label="Clone URL"
           data-urls='<%= h.json(meta.cloneUrls) %>'>
    <button type="button" class="clone-copy" data-copy-target="#clone-url" title="Copy clone URL">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path></svg>
      <span>Copy</span>
    </button>
    <a class="archive-button" href="/<%= repo.id %>/archive/tar.gz?ref=<%= refEncoded %>" title="Download tar.gz">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v10m0 0 4-4m-4 4-4-4M5 19h14"></path></svg>
    </a>
  </div>
</form>
