<%#
  The git HTTP endpoints are real, so these URLs work with `git clone` and
  `git push` once credentials are configured. A push URL is only offered to
  someone who may actually push: a URL that fails on push is worse than none.
%>
<div class="clone-form" data-clone>
  <div class="clone-tabs" role="tablist">
    <span class="clone-tab is-active">HTTP</span>
  </div>
  <div class="clone-row">
    <input class="clone-input" id="clone-url" readonly spellcheck="false"
           value="<%= h.escapeHtml(git.http) %>"
           aria-label="Git URL"
           data-urls='<%= h.json(git.urls) %>'>
    <button type="button" class="clone-copy" data-copy-target="#clone-url" title="Copy URL">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path></svg>
      <span>Copy</span>
    </button>
    <a class="archive-button" href="/<%= repo.id %>/archive/tar.gz?ref=<%= refEncoded %>" title="Download this ref as tar.gz">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v10m0 0 4-4m-4 4-4-4M5 19h14"></path></svg>
      <span class="sr-only">Download tar.gz</span>
    </a>
  </div>

  <% if (writeAccess.canWrite) { %>
    <p class="clone-note">
      You can push here. Authenticate once with
      <code>git config credential.helper store</code>, then
      <code>git push <%= h.escapeHtml(git.short) %> <%= h.escapeHtml(ref) %></code>.
    </p>
  <% } else { %>
    <p class="clone-note">
      Read-only for you<% if (writeAccess.owner && !writeAccess.owner.includes(':')) { %>
        &mdash; owned by <strong><%= h.escapeHtml(writeAccess.owner) %></strong><% } %>.
      You can still add files from this machine:
      <code>git push <%= h.escapeHtml(git.path) %> <%= h.escapeHtml(ref) %></code>
    </p>
  <% } %>
</div>
