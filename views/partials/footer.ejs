  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <span><%= site.title %></span>
      <span class="dot">·</span>
      <span>Node.js <%= process.versions.node %></span>
      <span class="dot">·</span>
      <a href="/api/status">API</a>
    </div>
  </footer>

  <script src="/js/app.js" defer></script>
  <script src="/js/write.js" defer></script>
<%#
  `pageScript` must arrive as include data. Assigning it in the calling view
  looks like it works, but EJS compiles each include separately, so the
  assignment lands on globalThis instead of the template locals - and then
  leaks into every later request in the same process, pulling the page script
  onto pages that never asked for it.
%>
<% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script src="<%= pageScript %>" defer></script>
<% } %>
</body>
</html>
