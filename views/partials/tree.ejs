<%
  const dirUrl = (rel) => `/${repo.id}/tree/${refEncoded}/${rel}`;
  const fileUrl = (rel) => `/${repo.id}/blob/${refEncoded}/${rel}`;
%>
<section class="panel file-tree">
  <div class="tree-toolbar">
    <% if (writeAccess.canWrite) { %>
      <a class="ghost-button" href="/<%= repo.id %>/edit/<%= refEncoded %>/<%= h.escapeHtml(path ? path + '/newfile.txt' : 'newfile.txt') %>">
        + New file
      </a>
      <button class="ghost-button" type="button" data-upload-toggle>Upload files</button>
    <% } else { %>
      <span class="tree-readonly">
        <%= path ? h.escapeHtml(path) : 'repository root' %>
      </span>
    <% } %>
  </div>

  <% if (writeAccess.canWrite) { %>
    <form class="upload-panel" data-upload-panel hidden
          method="post" enctype="multipart/form-data"
          action="/<%= repo.id %>/upload?_csrf=<%= encodeURIComponent(csrf) %>">
      <%# The token also rides in the query string: urlencoded parsing does not
          see a multipart body, so the hidden field below is ignored. %>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="branch" value="<%= h.escapeHtml(ref) %>">
      <input type="hidden" name="path" value="<%= h.escapeHtml(path) %>">

      <label class="upload-drop">
        <input type="file" name="files" multiple required>
        <span class="upload-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 16V5m0 0-4 4m4-4 4 4M4 18v1a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-1"></path></svg>
        </span>
        <span class="upload-hint">
          <strong>Choose files</strong> or drop them here
          <span class="upload-sub">Up to 5 MB each</span>
        </span>
      </label>

      <div class="upload-list" data-upload-list></div>

      <label class="field">
        <span>Commit message</span>
        <%# A placeholder, not a value: a pre-filled message is a commit
            message somebody forgot to write. %>
        <input type="text" name="message" required maxlength="500"
               placeholder="Add files to <%= h.escapeHtml(path || 'the repository root') %>">
      </label>

      <div class="editor-actions">
        <button class="primary-button" type="submit">Commit upload</button>
        <button class="ghost-button" type="button" data-upload-toggle>Close</button>
      </div>
    </form>
  <% } %>

  <% if (tree && tree.parent !== null && tree.parent !== undefined) { %>
    <a class="tree-up" href="<%= dirUrl(tree.parent) %>">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5m0 0-6 6m6-6 6 6"></path></svg>
      <span>..</span>
    </a>
  <% } %>

  <ul class="tree-list" data-tree-root="<%= path || '' %>">
    <% if (!tree || !tree.entries || !tree.entries.length) { %>
      <li class="tree-empty">This directory is empty.</li>
    <% } %>
    <% (tree ? tree.entries : []).forEach((entry) => { %>
      <li class="tree-row">
        <% if (entry.isSubmodule) { %>
          <span class="tree-name submodule">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4zM8 10h8"></path></svg>
            <%= entry.name %>
            <span class="tree-hint">submodule</span>
          </span>
        <% } else if (entry.isDir) { %>
          <a class="tree-name dir" href="<%= dirUrl(entry.path) %>">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="tree-icon"><path d="M3 7a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"></path></svg>
            <%= entry.name %>
          </a>
        <% } else { %>
          <a class="tree-name file" href="<%= fileUrl(entry.path) %>">
            <svg viewBox="0 0 24 24" aria-hidden="true" class="tree-icon"><path d="M6 3h8l4 4v14H6zM14 3v4h4"></path></svg>
            <%= entry.name %>
            <% if (entry.isSymlink) { %><span class="tree-hint">link</span><% } %>
          </a>
          <a class="tree-meta" href="/<%= repo.id %>/commits?ref=<%= refEncoded %>&path=<%= encodeURIComponent(entry.path) %>" title="History for <%= h.escapeHtml(entry.name) %>">history</a>
        <% } %>
        <%# Filled in with the file size by public/js/repo.js; blank for a directory. %>
        <span class="tree-commit"></span>
      </li>
    <% }) %>
  </ul>
</section>

<% if (readme) { %>
  <section class="panel readme">
    <div class="readme-head">
      <h2 class="panel-title"><%= readme.name %></h2>
      <a class="panel-more" href="/<%= repo.id %>/blob/<%= refEncoded %>/<%= readme.name %>">View source</a>
    </div>
    <article class="markdown"><%- readme.html %></article>
  </section>
<% } %>
