<%- include('partials/header', { title, site, filters: {}, user: false }) %>

<section class="auth-shell">
  <div class="auth-card">
    <h1 class="auth-title">Create an account</h1>

    <% if (isFirstUser) { %>
      <p class="notice">
        This is the first account on this server, so it will be an
        <strong>administrator</strong> — able to review repository requests.
      </p>
    <% } else { %>
      <p class="auth-sub">New accounts are ordinary members. Repository requests are reviewed by an administrator.</p>
    <% } %>

    <% if (error) { %>
      <p class="form-error" role="alert"><%- h.escapeHtml(error) %></p>
    <% } %>

    <form method="post" action="/register" class="form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <label class="field">
        <span>Display name <em>optional</em></span>
        <input type="text" name="displayName" value="<%- h.escapeHtml(values.displayName || '') %>"
               autocomplete="name" maxlength="64">
      </label>

      <label class="field">
        <span>Username</span>
        <input type="text" name="username" value="<%- h.escapeHtml(values.username || '') %>"
               autocomplete="username" required autofocus autocapitalize="none" spellcheck="false"
               pattern="[A-Za-z0-9][A-Za-z0-9._\-]{1,31}" title="2-32 characters: letters, digits, dot, dash, underscore">
      </label>

      <label class="field">
        <span>Password</span>
        <input type="password" name="password" autocomplete="new-password" required minlength="8">
        <small>At least 8 characters.</small>
      </label>

      <button class="primary-button wide" type="submit">Create account</button>
    </form>

    <p class="auth-alt">
      Already registered? <a href="/login">Sign in</a>.
    </p>
  </div>
</section>

<%- include('partials/footer') %>
