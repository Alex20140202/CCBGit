{
  "name": "ccb-git",
  "version": "1.0.0",
  "private": true,
  "description": "CCBGit - a self-hosted git repository website built with Node.js on both ends",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node bin/seed.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "compression": "^1.7.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.6",
    "morgan": "^1.10.0"
  }
}
