# Copy to .env and adjust, or just export these before `npm start`.
# Nothing here is required - every value has a sensible default.

# --- server ---------------------------------------------------------------
PORT=6600
HOST=0.0.0.0

# --- what to index --------------------------------------------------------
# Directories scanned for git repositories, separated by the OS path separator.
# Each repository is addressed as <parent-directory>/<repository-name>.
# Approved new repositories are created under the FIRST entry.
REPO_ROOTS=./repos

# --- accounts and access --------------------------------------------------
# User database, request queue and session key. Treat as state, not config:
# back this up, never commit it.
DATA_DIR=./data

# Signing key for session cookies. If unset, a random key is generated and
# stored in DATA_DIR/session.key, which keeps sessions valid across restarts.
# Set it explicitly to share sessions between instances.
# SESSION_SECRET=

# Allow self-registration. The first account created is always an admin.
# Set to false once the accounts you need exist.
ALLOW_SIGNUP=true

# Send session cookies only over HTTPS. Turn on when behind a TLS proxy.
COOKIE_SECURE=false
# Trust X-Forwarded-Proto. Only enable if a proxy you control sets it.
TRUST_PROXY=false

# --- branding -------------------------------------------------------------
SITE_TITLE=CCBGit
SITE_TAGLINE=A home for every repository on this machine.
SITE_OWNER=local

# --- git behaviour --------------------------------------------------------
GIT_BINARY=git
GIT_TIMEOUT=15000
# Largest file rendered in the browser, in bytes. Bigger files become a
# "download the raw file" notice.
MAX_BLOB_SIZE=2097152
PAGE_SIZE=30

# --- caching --------------------------------------------------------------
CACHE_ENABLED=true
# How long a git metadata lookup is reused, in milliseconds.
CACHE_TTL=15000
CACHE_MAX=500

# --- security -------------------------------------------------------------
# Render stack traces on 500 pages. Off by default; do not enable in public.
SHOW_STACKS=false
